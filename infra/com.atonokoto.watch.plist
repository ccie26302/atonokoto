<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.atonokoto.watch</string>
  <key>ProgramArguments</key>
  <array>
    <string>~/googleCloud/airlock/.venv/bin/python</string>
    <string>~/atonokoto/agents/watch/run.py</string>
  </array>
  <key>WorkingDirectory</key><string>~/atonokoto</string>
  <key>StartCalendarInterval</key><dict><key>Hour</key><integer>6</integer><key>Minute</key><integer>30</integer></dict>
  <key>StandardOutPath</key><string>~/atonokoto/data/watch_launchd.log</string>
  <key>StandardErrorPath</key><string>~/atonokoto/data/watch_launchd.log</string>
  <key>EnvironmentVariables</key><dict><key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string></dict>
</dict>
</plist>
